# ==========================================
# Jenkins IAM Role & Instance Profile
# ==========================================
resource "aws_iam_role" "jenkins_role" {
  name = "ekscicd-jenkins-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ec2.amazonaws.com"
        }
      }
    ]
  })
}

